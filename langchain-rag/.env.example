# Local HTTP server
HOST=127.0.0.1
PORT=3001

# OpenAI generation and retrieval
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VECTOR_STORE_ID=

# LangSmith tracing
# Keep tracing disabled until you intend to send traces to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Required when the LangSmith workspace is outside the default US region.
LANGSMITH_ENDPOINT=
# Required only when an API key can access multiple workspaces.
LANGSMITH_WORKSPACE_ID=
LANGSMITH_DATASET_NAME=demoshop-rag-evaluation

# Current LangSmith Cloud workspaces: set the agent ID and environment, then
# clear LANGSMITH_PROJECT below.
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=local

# Project-based or self-hosted workspaces: use this instead of agent addressing.
LANGSMITH_PROJECT=demoshop-langchain-rag

# Optional privacy and version controls.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
LANGSMITH_REVISION_ID=

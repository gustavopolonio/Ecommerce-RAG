{
  "name": "demoshop-langchain-rag",
  "version": "0.1.0",
  "private": true,
  "description": "An isolated LangChain and LangSmith rebuild of the DemoShop RAG application.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dataset:dry-run": "node --import tsx src/dataset/run-dataset-dry-run.ts",
    "dataset:upload": "node --import tsx src/dataset/upload-langsmith-dataset.ts",
    "dev": "tsx watch src/server.ts",
    "evaluation:preview": "node --import tsx src/evaluation/run-evaluation-preview.ts",
    "evaluation:report": "node --import tsx src/evaluation/regenerate-evaluation-report.ts",
    "evaluation:run": "node --import tsx src/evaluation/run-evaluation-experiment.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "trace:smoke": "tsx src/tracing/run-live-smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.3.5",
    "@langchain/openai": "^1.8.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "langsmith": "^0.11.8",
    "openai": "^7.54.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}

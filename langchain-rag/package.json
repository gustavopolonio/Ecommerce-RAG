{
  "name": "demoshop-langchain-rag",
  "version": "0.1.0",
  "private": true,
  "description": "An isolated LangChain and LangSmith rebuild of the DemoShop RAG application.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "trace:smoke": "tsx src/tracing/run-live-smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.3.5",
    "@langchain/openai": "^1.8.2",
    "dotenv": "^18.0.9",
    "langsmith": "^0.11.8",
    "openai": "^7.54.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
